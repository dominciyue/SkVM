{
  "schemaVersion": "law-to-markdown-tool-plan/v1",
  "mode": "direct-deterministic-process",
  "interpreter": {
    "env": "SKVM_PYTHON",
    "fallbackCommand": "python",
    "minimumVersion": "3.10"
  },
  "input": "document.txt",
  "outputDirectory": "markdown",
  "arguments": [
    "--law-decision",
    "auto",
    "--artifact-level",
    "minimal"
  ],
  "shell": false,
  "network": "forbidden",
  "packageInstall": "forbidden"
}
