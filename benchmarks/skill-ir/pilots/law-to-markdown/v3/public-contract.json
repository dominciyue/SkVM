{
  "schemaVersion": "skill-ir-law-to-markdown-public-contract/v3",
  "contractId": "law-to-markdown-public-contract-v3",
  "protectedInputs": ["document.txt", "law-contract.json"],
  "outputs": {
    "review": "markdown/document/document+审核报告.md",
    "deliverable": "markdown/document/document+最终成果.md"
  },
  "exactOutputSet": true,
  "classification": {
    "law": "The first nonempty line ends in 法、条例 or 规定 and the body contains at least one 第X条 heading.",
    "non-law": "The first nonempty line begins with GB/, GB／, ISO or IEC.",
    "ambiguous": "Inputs matching neither rule are outside this benchmark revision."
  },
  "headingRules": [
    { "kind": "title", "level": 1 },
    { "kind": "编或分编", "level": 2 },
    { "kind": "章", "level": 3 },
    { "kind": "节", "level": 4 },
    { "kind": "条", "level": 5 }
  ],
  "contentRules": [
    "A legal deliverable preserves the source character stream after Markdown heading markers and whitespace are removed.",
    "Chinese enumerated items such as （一）（二） are placed on separate nonempty lines.",
    "A non-law input produces no final deliverable."
  ],
  "reviewEvidence": {
    "openingMarker": "```json law-review-evidence",
    "closingMarker": "```",
    "blockCount": 1,
    "fields": ["inputPath", "documentClass", "deliverablePath"],
    "documentClasses": ["law", "non-law"]
  },
  "outputAbi": {
    "schemaVersion": "skill-ir-public-output-abi/v1",
    "additionalProperties": false,
    "fields": {
      "inputPath": {
        "required": true,
        "schema": { "type": "string", "nullable": false, "enum": ["document.txt"] }
      },
      "documentClass": {
        "required": true,
        "schema": { "type": "string", "nullable": false, "enum": ["law", "non-law"] }
      },
      "deliverablePath": {
        "required": true,
        "schema": {
          "type": "string",
          "nullable": true,
          "enum": ["markdown/document/document+最终成果.md"]
        }
      }
    }
  }
}
