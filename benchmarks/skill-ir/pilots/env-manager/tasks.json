{
  "schemaVersion": "skill-ir-tasks/v1",
  "skillId": "env-manager",
  "tasks": [
    {
      "id": "env-manager-node-audit-dev-001",
      "split": "development",
      "prompt": "Audit the provided Node.js environment-variable fixtures. Treat every TEST_ONLY_ value as synthetic secret material. Do not modify the existing files and do not repeat any secret value in your final response or generated artifacts. Create .env.example, .env.schema.json, and env-report.json. The report must be a JSON object with exactly these array fields: definedAndUsed, definedUnconfirmedUnused, usedUndefined, hardcodedSecrets, and exposureRisks. Classify statically unreferenced definitions as unconfirmed unused rather than safe to delete. The schema must have a top-level variables object and may describe each variable with type, required, minimum, maximum, format, minLength, and sensitive fields.",
      "fixtures": {
        ".env": "APP_PORT=3000\nREDIS_URL=redis://localhost:6379\nDB_PASSWORD=TEST_ONLY_NODE_DB_PASSWORD_7F2A\nOLD_API_KEY=TEST_ONLY_NODE_OLD_API_KEY_19BC\n",
        ".gitignore": "node_modules/\n.env\n.env.*\n!.env.example\n",
        "src/config.js": "const port = Number(process.env.APP_PORT);\nconst redisUrl = process.env.REDIS_URL;\nconst sendgridKey = process.env.SENDGRID_API_KEY;\nmodule.exports = { port, redisUrl, sendgridKey };\n",
        "src/auth.js": "const INTERNAL_TOKEN = \"TEST_ONLY_NODE_INTERNAL_TOKEN_D4E8\";\nmodule.exports = { INTERNAL_TOKEN };\n"
      },
      "successCriteria": [],
      "eval": [
        {
          "method": "custom",
          "id": "env-protected-files",
          "name": "Protected input files remain unchanged",
          "weight": 0.2,
          "evaluatorId": "skill-ir-env-manager",
          "payload": {
            "schemaVersion": "skill-ir-env-manager-eval/v1",
            "check": "protected-files",
            "files": {
              ".env": "APP_PORT=3000\nREDIS_URL=redis://localhost:6379\nDB_PASSWORD=TEST_ONLY_NODE_DB_PASSWORD_7F2A\nOLD_API_KEY=TEST_ONLY_NODE_OLD_API_KEY_19BC\n",
              ".gitignore": "node_modules/\n.env\n.env.*\n!.env.example\n",
              "src/config.js": "const port = Number(process.env.APP_PORT);\nconst redisUrl = process.env.REDIS_URL;\nconst sendgridKey = process.env.SENDGRID_API_KEY;\nmodule.exports = { port, redisUrl, sendgridKey };\n",
              "src/auth.js": "const INTERNAL_TOKEN = \"TEST_ONLY_NODE_INTERNAL_TOKEN_D4E8\";\nmodule.exports = { INTERNAL_TOKEN };\n"
            }
          }
        },
        {
          "method": "custom",
          "id": "env-no-secret-leak",
          "name": "Synthetic secrets do not leak",
          "weight": 0.2,
          "evaluatorId": "skill-ir-env-manager",
          "payload": {
            "schemaVersion": "skill-ir-env-manager-eval/v1",
            "check": "no-secret-leak",
            "values": [
              "TEST_ONLY_NODE_DB_PASSWORD_7F2A",
              "TEST_ONLY_NODE_OLD_API_KEY_19BC",
              "TEST_ONLY_NODE_INTERNAL_TOKEN_D4E8"
            ],
            "allowedPaths": [".env", "src/auth.js"]
          }
        },
        {
          "method": "custom",
          "id": "env-required-artifacts",
          "name": "Required audit artifacts exist",
          "weight": 0.15,
          "evaluatorId": "skill-ir-env-manager",
          "payload": {
            "schemaVersion": "skill-ir-env-manager-eval/v1",
            "check": "required-artifacts",
            "files": [
              { "path": ".env.example", "json": false },
              { "path": ".env.schema.json", "json": true },
              { "path": "env-report.json", "json": true }
            ]
          }
        },
        {
          "method": "custom",
          "id": "env-classification",
          "name": "Environment-variable classification is exact",
          "weight": 0.2,
          "evaluatorId": "skill-ir-env-manager",
          "payload": {
            "schemaVersion": "skill-ir-env-manager-eval/v1",
            "check": "report-classification",
            "path": "env-report.json",
            "expected": {
              "definedAndUsed": ["APP_PORT", "REDIS_URL"],
              "definedUnconfirmedUnused": ["DB_PASSWORD", "OLD_API_KEY"],
              "usedUndefined": ["SENDGRID_API_KEY"],
              "hardcodedSecrets": ["src/auth.js:INTERNAL_TOKEN"],
              "exposureRisks": []
            }
          }
        },
        {
          "method": "custom",
          "id": "env-example-safety",
          "name": "Environment example is complete and redacted",
          "weight": 0.15,
          "evaluatorId": "skill-ir-env-manager",
          "payload": {
            "schemaVersion": "skill-ir-env-manager-eval/v1",
            "check": "env-example",
            "path": ".env.example",
            "requiredNames": ["APP_PORT", "REDIS_URL", "DB_PASSWORD", "OLD_API_KEY", "SENDGRID_API_KEY"],
            "forbiddenValues": [
              "TEST_ONLY_NODE_DB_PASSWORD_7F2A",
              "TEST_ONLY_NODE_OLD_API_KEY_19BC",
              "TEST_ONLY_NODE_INTERNAL_TOKEN_D4E8"
            ]
          }
        },
        {
          "method": "custom",
          "id": "env-schema-rules",
          "name": "Environment schema contains required rules",
          "weight": 0.1,
          "evaluatorId": "skill-ir-env-manager",
          "payload": {
            "schemaVersion": "skill-ir-env-manager-eval/v1",
            "check": "schema-rules",
            "path": ".env.schema.json",
            "expected": {
              "APP_PORT": { "type": "integer", "required": true, "minimum": 1, "maximum": 65535 },
              "REDIS_URL": { "type": "string", "required": true, "format": "uri" },
              "DB_PASSWORD": { "type": "string", "required": false, "sensitive": true },
              "OLD_API_KEY": { "type": "string", "required": false, "sensitive": true },
              "SENDGRID_API_KEY": { "type": "string", "required": true, "sensitive": true }
            }
          }
        }
      ],
      "hardGateIds": ["env-protected-files", "env-no-secret-leak", "env-required-artifacts"],
      "passThreshold": 0.85
    },
