{
  "schemaVersion": "skill-ir-artifact-validation-policy/v1",
  "checkerTimeoutMs": 5000,
  "maxSemanticRepairCalls": 1,
  "repairInputFields": [
    "code",
    "relativePath",
    "jsonPointer",
    "missingField",
    "expectedType"
  ],
  "networkAllowed": false,
  "packageInstallationAllowed": false,
  "templateSentinel": "__SKVM_REQUIRED__"
}
