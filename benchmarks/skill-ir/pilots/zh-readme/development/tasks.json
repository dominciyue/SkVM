    {
      "id": "zh-readme-node-cli-dev-001",
      "split": "development",
      "prompt": "Inspect every protected repository file and read readme-interface.json without modifying any input. Create a Chinese README.zh-CN.md that explains the project identity and includes source-supported installation, quick-start, development, and license information. Use only commands, local paths, and links supported by repository evidence; omit or mark unsupported facts as pending. Produce exactly README.zh-CN.md. Do not use the network, install packages, or execute project code.",
      "fixtures": {
        "package.json": "{\n  \"name\": \"echo-lab\",\n  \"version\": \"1.2.0\",\n  \"description\": \"Filter JSON Lines events into concise terminal summaries.\",\n  \"license\": \"MIT\",\n  \"homepage\": \"https://example.org/echo-lab/docs\",\n  \"repository\": {\n    \"type\": \"git\",\n    \"url\": \"https://github.com/example/echo-lab\"\n  },\n  \"bin\": {\n    \"echo-lab\": \"src/cli.js\"\n  },\n  \"scripts\": {\n    \"start\": \"node src/cli.js\",\n    \"test\": \"node --test\",\n    \"lint\": \"node --check src/cli.js\"\n  }\n}\n",
        "src/cli.js": "export function summarize(line) { return JSON.parse(line).message }\n// Usage: echo-lab --input events.jsonl --level warn\n",
        "README.md": "# Echo Lab\n\nCommand-line JSON Lines event summaries.\n",
        "LICENSE": "MIT License\n",
        "readme-interface.json": "{\n  \"schemaVersion\": \"skill-ir-zh-readme-interface/v1\",\n  \"interfaceId\": \"zh-readme-repository-fact-interface-v1\",\n  \"protectedInputs\": [\"<repository-files>\", \"readme-interface.json\"],\n  \"outputs\": [\"README.zh-CN.md\"],\n  \"language\": {\n    \"primary\": \"zh-CN\",\n    \"technicalEnglishAllowed\": true\n  },\n  \"semanticRoles\": [\"identity\", \"installation\", \"quickstart\", \"development\", \"license\"],\n  \"factPolicy\": {\n    \"sources\": [\"project-manifest\", \"entry-source\", \"existing-documentation\", \"license\"],\n    \"commandsMustBeSourceDerived\": true,\n    \"pathsMustExist\": true,\n    \"linksMustBeSourceDeclared\": true,\n    \"missingEvidence\": \"omit-or-mark-pending\",\n    \"exactWordingRequired\": false,\n    \"headingOrderRequired\": false\n  },\n  \"optionalPresentation\": {\n    \"badges\": true,\n    \"emoji\": true,\n    \"socialProofOnlyWhenSourceDeclared\": true\n  },\n  \"resourcePolicy\": {\n    \"network\": false,\n    \"packageInstall\": false,\n    \"executeProjectCode\": false,\n    \"allowedRuntime\": \"node\"\n  },\n  \"outputPolicy\": {\n    \"exactOutputSet\": true,\n    \"protectedInputsMutable\": false\n  }\n}\n"
      },
      "successCriteria": [],
