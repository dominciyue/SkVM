{
  "openapi": "3.0.3",
  "info": { "title": "Nested array items boundary", "version": "1" },
  "paths": {
    "/items": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "items": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" } } } }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "ok" }, "400": { "description": "bad" } }
      }
    }
  }
}
