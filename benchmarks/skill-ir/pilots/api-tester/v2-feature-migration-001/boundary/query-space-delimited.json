{
  "openapi": "3.0.3",
  "info": { "title": "Query style boundary", "version": "1" },
  "paths": {
    "/items": {
      "get": {
        "parameters": [
          {
            "name": "tags",
            "in": "query",
            "style": "spaceDelimited",
            "explode": false,
            "schema": { "type": "array", "items": { "type": "string" } }
          }
        ],
        "responses": { "200": { "description": "ok" }, "400": { "description": "bad" } }
      }
    }
  }
}
