{
  "schemaVersion": "api-tester-tool-plan/v1",
  "mode": "schema-derived-offline-generation",
  "variant": {
    "id": "openapi-yaml",
    "inputPath": "api/openapi.yaml",
    "inputFormat": "yaml"
  },
  "outputs": {
    "generator": "api-test-generator.mjs",
    "plan": "generated/api-test-plan.json",
    "report": "api-test-report.json"
  },
  "interpreter": {
    "env": "SKVM_NODE",
    "fallbackCommand": "node",
    "minimumVersion": "23"
  },
  "shell": false,
  "network": "forbidden",
  "packageInstall": "forbidden"
}
