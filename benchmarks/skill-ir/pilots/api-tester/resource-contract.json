{
  "schemaVersion": "skill-ir-resource-contract/v1",
  "inputFormats": ["json", "yaml"],
  "network": "forbidden",
  "packageInstall": "forbidden",
  "interpreter": {
    "env": "SKVM_NODE",
    "fallbackCommand": "node",
    "minimumVersion": "23"
  },
  "probe": {
    "args": [
      "--input-type=module",
      "-e",
      "import('yaml').then(() => console.log('SKVM_API_TESTER_NODE_YAML_OK'))"
    ],
    "requiredModules": ["yaml"],
    "successMarker": "SKVM_API_TESTER_NODE_YAML_OK"
  },
  "missingDependencyDisposition": "preflight-infrastructure"
}
