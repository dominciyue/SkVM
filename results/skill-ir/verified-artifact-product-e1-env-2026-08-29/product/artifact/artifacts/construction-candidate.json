{
  "schemaVersion": "skill-ir-domain-automatic-construction-result/v1",
  "contract": {
    "schemaVersion": "skill-ir-domain-contract-candidate/v1",
    "skillId": "env-manager",
    "taskDescriptionId": "env-manager-audit-task",
    "taskKind": "workspace-transformation",
    "intent": "环境变量管理器：扫描、校验、同步 .env 文件，生成安全配置模板",
    "inputs": [
      {
        "id": "environment-file",
        "path": ".env",
        "format": "text",
        "access": "read-only",
        "required": true
      },
      {
        "id": "project-source",
        "path": "<project-source-files>",
        "format": "directory",
        "access": "read-only",
        "required": true
      },
      {
        "id": "public-interface",
        "path": "env-audit-interface.json",
        "format": "json",
        "access": "read-only",
        "required": true
      }
    ],
    "outputs": [
      {
        "id": "environment-example",
        "path": ".env.example",
        "format": "text",
        "required": true,
        "structure": {
          "kind": "opaque"
        }
      },
      {
        "id": "environment-schema",
        "path": ".env.schema.json",
        "format": "json",
        "required": true,
        "structure": {
          "kind": "opaque"
        }
      },
      {
        "id": "environment-report",
        "path": "env-report.json",
        "format": "json",
        "required": true,
        "structure": {
          "kind": "json-object",
          "requiredFields": [
            "definedAndUsed",
            "definedUnconfirmedUnused",
            "usedUndefined",
            "hardcodedSecrets",
            "exposureRisks"
          ],
          "allowAdditionalFields": true
        }
      }
    ],
    "passCriteria": [
      {
        "id": "inputs-stable",
        "predicate": "input-integrity",
        "targetRefs": [
          "environment-file",
          "project-source",
          "public-interface"
        ],
        "statement": "Every initial workspace entry remains unchanged."
      },
      {
        "id": "outputs-exact",
        "predicate": "exact-output-set",
        "targetRefs": [
          "environment-example",
          "environment-schema",
          "environment-report"
        ],
        "statement": "Only the three declared audit artifacts are created."
      },
      {
        "id": "report-shape",
        "predicate": "json-shape",
        "targetRefs": [
          "environment-report"
        ],
        "statement": "The report contains all declared finding collections."
      },
      {
        "id": "environment-classification",
        "predicate": "source-grounding",
        "targetRefs": [
          "environment-file",
          "project-source",
          "environment-report"
        ],
        "statement": "Defined, referenced, missing, and sensitive variables follow observable workspace evidence."
      },
      {
        "id": "artifact-consistency",
        "predicate": "cross-artifact-consistency",
        "targetRefs": [
          "environment-example",
          "environment-schema",
          "environment-report"
        ],
        "statement": "Example, schema, and report describe the same variable inventory and requiredness."
      },
      {
        "id": "secret-redaction",
        "predicate": "content-fidelity",
        "targetRefs": [
          "environment-file",
          "environment-example",
          "environment-report"
        ],
        "statement": "Sensitive values are never copied into generated artifacts."
      }
    ],
    "sourceRules": [
      {
        "id": "rule-01",
        "sourceText": "[ ] 扫描和报告只展示变量名及脱敏状态，不回显真实 Secret"
      },
      {
        "id": "rule-02",
        "sourceText": "[ ] `.env` 已添加到 `.gitignore`"
      },
      {
        "id": "rule-03",
        "sourceText": "[ ] `.env.example` 存在且与代码同步"
      },
      {
        "id": "rule-04",
        "sourceText": "[ ] 无硬编码的 API Key / Token / Password"
      },
      {
        "id": "rule-05",
        "sourceText": "[ ] 生产环境使用 Secrets 管理（GitHub Secrets / AWS SSM / Vault）"
      },
      {
        "id": "rule-06",
        "sourceText": "[ ] JWT_SECRET / ENCRYPTION_KEY 足够随机（32+ 字符）"
      },
      {
        "id": "rule-07",
        "sourceText": "[ ] 数据库密码不在日志中输出"
      },
      {
        "id": "rule-08",
        "sourceText": "不要自动删除或改写真实 `.env`；先展示差异并取得用户确认。"
      },
      {
        "id": "rule-09",
        "sourceText": "“未使用”只代表静态扫描没有发现，仍需检查 CI、容器、部署平台和动态变量访问。"
      },
      {
        "id": "rule-10",
        "sourceText": "不把生产 Secret 复制到 `.env.example`、Schema、日志、Issue 或聊天输出中。"
      },
      {
        "id": "rule-11",
        "sourceText": "**Next.js**：只有 `NEXT_PUBLIC_` 前缀的变量会暴露给客户端，后端专用变量不要加此前缀"
      },
      {
        "id": "rule-12",
        "sourceText": "**Docker**：构建时的 ARG 和运行时的 ENV 是不同的，不要混淆"
      },
      {
        "id": "rule-13",
        "sourceText": "**Create React App**：`.env` 中的变量必须以 `REACT_APP_` 开头才会被注入"
      },
      {
        "id": "rule-14",
        "sourceText": "**Vite**：使用 `VITE_` 前缀暴露变量给客户端"
      },
      {
        "id": "rule-15",
        "sourceText": "**monorepo**：根目录的 `.env` 不会自动被子包读取，需要显式配置"
      }
    ]
  },
