{
  "schemaVersion": "technical-document-localization/v0",
  "id": "direct-guide-zh",
  "task": {
    "naturalRequest": "Translate guide.md to Simplified Chinese, preserve code, commands, URL destinations, environment variables and placeholders, and ask when a product term is ambiguous.",
    "sourceLocale": "en",
    "ambiguity": "ask"
  },
  "input": {
    "id": "guide",
    "path": "guide.md",
    "format": "markdown"
  },
  "targets": [
    {
      "id": "zh",
      "locale": "zh-CN",
      "path": "guide.zh-CN.md",
      "overwrite": "never",
      "independent": true
    }
  ],
  "protection": {
    "profile": "technical-markdown/v0",
    "lexicalKinds": ["url", "placeholder", "environment-variable", "path", "command"]
  },
  "policies": {
    "partialTargets": "forbid",
    "semanticReview": "optional"
  },
  "provenance": {
    "kind": "direct-authored",
    "source": "Natural task plus explicit local input/target bindings; no prior skill program."
  }
}
