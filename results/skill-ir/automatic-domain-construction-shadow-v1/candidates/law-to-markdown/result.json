{
  "schemaVersion": "skill-ir-domain-automatic-construction-result/v1",
  "contract": {
    "schemaVersion": "skill-ir-domain-contract-candidate/v1",
    "skillId": "law-to-markdown",
    "taskDescriptionId": "law-markdown-conversion-task",
    "taskKind": "workspace-transformation",
    "intent": "将法条/规范文件（.txt/.docx/.pdf）转为 Markdown。适用于用户要求“法条转 markdown”“pdf/docx 转 markdown”。处理 .pdf/.docx 时先检查是否已安装 mineru-ocr skill；未安装先引导安装，安装后优先用 mineru-ocr；仅在用户明确同意时再用本地回退方案。",
    "inputs": [
      {
        "id": "document",
        "path": "document.txt",
        "format": "text",
        "access": "read-only",
        "required": true
      },
      {
        "id": "public-contract",
        "path": "law-contract.json",
        "format": "json",
        "access": "read-only",
        "required": true
      }
    ],
    "outputs": [
      {
        "id": "review-report",
        "path": "markdown/document/document+审核报告.md",
        "format": "markdown",
        "required": true,
        "structure": {
          "kind": "markdown",
          "requiredSemanticRoles": [
            "document classification",
            "structured review evidence"
          ]
        }
      },
      {
        "id": "law-deliverable",
        "path": "markdown/document/document+最终成果.md",
        "format": "markdown",
        "required": false,
        "structure": {
          "kind": "markdown",
          "requiredSemanticRoles": [
            "legal hierarchy",
            "source content"
          ]
        }
      }
    ],
    "passCriteria": [
      {
        "id": "inputs-stable",
        "predicate": "input-integrity",
        "targetRefs": [
          "document",
          "public-contract"
        ],
        "statement": "The source document and public contract remain unchanged."
      },
      {
        "id": "outputs-exact",
        "predicate": "exact-output-set",
        "targetRefs": [
          "review-report",
          "law-deliverable"
        ],
        "statement": "No undeclared file is created and the optional deliverable follows classification."
      },
      {
        "id": "document-classification",
        "predicate": "source-grounding",
        "targetRefs": [
          "document",
          "review-report",
          "law-deliverable"
        ],
        "statement": "Law versus non-law classification follows observable title and article markers."
      },
      {
        "id": "legal-fidelity",
        "predicate": "content-fidelity",
        "targetRefs": [
          "document",
          "law-deliverable"
        ],
        "statement": "A legal deliverable preserves the source character stream apart from Markdown markers and whitespace."
      },
      {
        "id": "legal-structure",
        "predicate": "source-grounding",
        "targetRefs": [
          "document",
          "law-deliverable"
        ],
        "statement": "Markdown heading levels and enumerated-item layout follow the declared legal hierarchy."
      },
      {
        "id": "review-consistency",
        "predicate": "cross-artifact-consistency",
        "targetRefs": [
          "review-report",
          "law-deliverable"
        ],
        "statement": "Structured review evidence agrees with classification and deliverable presence."
      }
    ],
    "sourceRules": [
      {
        "id": "rule-01",
        "sourceText": "输入为 `.txt`：直接转存为 `.md`。"
      },
      {
        "id": "rule-02",
        "sourceText": "输入为 `.pdf` / `.docx`："
      },
      {
        "id": "rule-03",
        "sourceText": "先检查是否已安装 `mineru-ocr` skill。"
      },
      {
        "id": "rule-04",
        "sourceText": "未安装：提示先安装 `mineru-ocr`，安装地址："
      },
      {
        "id": "rule-05",
        "sourceText": "已安装：优先调用 `mineru-ocr` 处理。"
      },
      {
        "id": "rule-06",
        "sourceText": "调用失败：先提示检查 `mineru-ocr` 配置/Token。"
      },
      {
        "id": "rule-07",
        "sourceText": "仅当用户明确同意时，才使用本地回退（`python-docx` / `pdfplumber`）。"
      },
      {
        "id": "rule-08",
        "sourceText": "第一阶段完成后默认执行第二阶段格式调整（仅格式，不改原文字符）："
      },
      {
        "id": "rule-09",
        "sourceText": "由调用该 skill 的大模型先判断“法律/非法律”，并把结果传给脚本。"
      },
      {
        "id": "rule-10",
        "sourceText": "若调用方未传结果，则脚本使用硬规则自动识别（`--law-decision auto`）。"
      },
      {
        "id": "rule-11",
        "sourceText": "法律名称 `#`"
      },
      {
        "id": "rule-12",
        "sourceText": "编/分编 `##`"
      },
      {
        "id": "rule-13",
        "sourceText": "章 `###`"
      },
      {
        "id": "rule-14",
        "sourceText": "节 `####`"
      },
      {
        "id": "rule-15",
        "sourceText": "条 `#####`（仅“第X条”为标题；`第X条【条标】`整行为标题不拆）"
      },
      {
        "id": "rule-16",
        "sourceText": "款/项/目无标题"
      },
      {
        "id": "rule-17",
        "sourceText": "项、目按标记换行"
      },
      {
        "id": "rule-18",
        "sourceText": "清理多余空格：去行尾空格、去行首 ASCII 空格、去正文行首全角缩进、规范标题后的空格"
      },
      {
        "id": "rule-19",
        "sourceText": "若识别为明显非法律文本（如 GB/标准类文档），第二阶段明确拒绝：`Stage2: rejected (non-law-document)`。"
      },
      {
        "id": "rule-20",
        "sourceText": "若第二阶段未识别法律结构或保真校验失败，则自动 no-op，不改文本。"
      },
      {
        "id": "rule-21",
        "sourceText": "默认执行第三阶段检查（双子阶段，硬门槛）："
      },
      {
        "id": "rule-22",
        "sourceText": "Stage3-A：校验 `stage2` 相对 `stage1` 的文字内容准确性（去标题符号与空白后字符流必须一致）"
      },
      {
        "id": "rule-23",
        "sourceText": "Stage3-B：校验结构效果（结构层级、条标题规则、非法律策略、空格规范、项/目换行）"
      },
      {
        "id": "rule-24",
        "sourceText": "任一失败触发自动重走，最多 2 次；仍失败默认报错退出"
      },
      {
        "id": "rule-25",
        "sourceText": "默认输出到输入文件同目录的 `markdown/` 子目录，并按输入文件名创建独立目录："
      },
      {
        "id": "rule-26",
        "sourceText": "`markdown/<文件名>/`"
      },
      {
        "id": "rule-27",
        "sourceText": "默认（`--artifact-level minimal`）输出："
      },
      {
        "id": "rule-28",
        "sourceText": "`<原文件名>+审核报告.md`（详细过程和结论）"
      },
      {
        "id": "rule-29",
        "sourceText": "`<原文件名>+最终成果.md`（仅法律文本且审核通过时生成）"
      },
      {
        "id": "rule-30",
        "sourceText": "非法律文档（如 GB/标准类）："
      },
      {
        "id": "rule-31",
        "sourceText": "结论为“拒绝处理”"
      },
      {
        "id": "rule-32",
        "sourceText": "仅输出 `<原文件名>+审核报告.md`"
      }
    ]
  },
