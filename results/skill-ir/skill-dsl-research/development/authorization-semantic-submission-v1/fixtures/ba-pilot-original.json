    {
      "call": {
        "id": "exec-fffdf93b-ef18-4e68-af9d-da2157ae1663",
        "name": "authorization_check_result",
        "arguments": {
          "result": {
            "schemaVersion": "authorization-focused-result/v1",
            "focusId": "focus-a0a03fd1bca6354680fec9be",
            "scope": "q1 document download behavior",
            "answers": [
              {
                "questionId": "q1",
                "disposition": "conditional",
                "explanation": "Download is an authenticated DRF detail action. The path pk first resolves a request document and its root document. Authorization is evaluated against that root using has_perms_owner_aware(request.user, 'view_document', root_doc); failure returns 403. Only after that check does version selection choose file_doc. A direct version pk without a version query returns that version; otherwise version=<id> may select only the root or one of its versions, and no version value selects the newest version. Thus selecting another valid version changes the file-bearing document but not the authorized object: authorization remains on the common root. original=true selects the original representation; otherwise an archive is used when the selected file_doc has one. Ownership and object-grant outcomes are unspecified, so no concrete caller is classified as allowed beyond these branches.",
                "paths": [
                  {
                    "path": 0,
                    "disposition": "deny",
                    "explanation": "If DRF authentication or configured view permission checks fail, the action is not invoked."
                  },
                  {
                    "path": 1,
                    "disposition": "deny",
                    "explanation": "For an authenticated caller lacking owner-aware view_document permission on the resolved root document, file_response returns HTTP 403 before version or representation selection."
                  },
                  {
                    "path": 2,
                    "disposition": "deny",
                    "explanation": "A missing path document, invalid/missing requested version, unrelated version id, or missing file yields 404/NotFound rather than file content."
                  },
                  {
                    "path": 3,
                    "disposition": "allow",
                    "explanation": "When upstream checks pass and the caller has view_document on the resolved root, a valid selected version is served; original=true chooses its original, otherwise its archive is chosen when present."
                  }
                ],
                "gaps": [
                  {
                    "kind": "premise-unknown",
                    "detail": "The authenticated user's ownership and object-level grants for the resolved root document are unspecified."
                  },
                  {
                    "kind": "source-gap",
                    "detail": "The implementation of serve_file and deployment-specific file-serving/proxy behavior were not needed to determine the authorized-object relation and were not traced."
                  }
                ]
              }
            ]
          }
        }
      },
      "diagnostics": [
        {
          "path": "/result/answers/0",
          "keyword": "unrecognized_keys",
          "message": "Unrecognized key(s) in object: 'questionId', 'gaps'",
          "expected": {
            "additionalProperties": [
              "questionId",
              "gaps"
            ]
          }
        }
      ]
    }
