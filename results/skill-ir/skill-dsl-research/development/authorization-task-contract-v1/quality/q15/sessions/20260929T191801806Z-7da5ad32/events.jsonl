alse","unknown"]}},"required":["conditionId","value"],"additionalProperties":false}},"effect":{"type":"string","enum":["reachable","blocked","unknown"]},"explanation":{"type":"string"},"missingFacts":{"type":"array","items":{"type":"string"}},"factIds":{"type":"array","items":{"type":"string"}}},"required":["id","assumptions","effect","explanation","missingFacts","factIds"],"additionalProperties":false}}},"required":["obligationId","explanation","facts","decisiveMissingFacts","suggestedObservations","decision","branchResults"],"additionalProperties":false}}},"required":["results"],"additionalProperties":false}]},"usage":{"input":169,"output":951,"cacheRead":3456,"cacheWrite":0},"costUsd":null,"transportAttempts":"unknown","response":{"text":"","toolCalls":[{"id":"call_T2DfG3Q00RuNRL1jtufwoMsj","name":"submit_authorization_result","arguments":{"results":[{"obligationId":"scenario%3Aglobal-only-no-document-view::entry%3Ashare-create","decision":{"kind":"observed","observed":"deny"},"branchResults":[],"explanation":"At the declared ShareLinkViewSet.create entry, the viewset uses IsAuthenticated and PaperlessObjectPermissions, and the POST mapping for that permission class requires add_sharelink for the ShareLink model. Under the premises, the caller's global add_sharelink satisfies authorization to create the share-link object. The create mixin's serializer is obtained through PassUserMixin, which supplies request.user to serializers supporting SerializerWithPerms. During serializer validation, validate_document requires both global documents.view_document and has_perms_owner_aware(..., \"view_document\", document). For a document owned by another user, the owner-aware helper permits only an owner or a guardian-backed object grant; the premises exclude both the owner case and the object grant. Therefore the target-document condition fails and validation raises PermissionDenied before the share-link object is created. The caller's global view_document permission satisfies only the first conjunct; it does not substitute for the owner-aware object check. The observed result is deny for this scenario, distinguishing share-link creation authorization from authorization to view the referenced document.","facts":[{"id":"entry-share-create","kind":"entry","statement":"ShareLinkViewSet is the create-capable viewset entry for ShareLink and uses ShareLinkSerializer.","citations":[{"sourceId":"src-b740d736ac7a1cf1","startLine":4696,"endLine":4708}]},{"id":"binding-sharelink-permissions","kind":"binding","statement":"ShareLinkViewSet applies IsAuthenticated and PaperlessObjectPermissions.","citations":[{"sourceId":"src-b740d736ac7a1cf1","startLine":4708,"endLine":4710}]},{"id":"binding-sharelink-user","kind":"binding","statement":"PassUserMixin supplies request.user to serializers that subclass SerializerWithPerms.","citations":[{"sourceId":"src-b740d736ac7a1cf1","startLine":406,"endLine":418}]},{"id":"resource-target-document","kind":"binding","statement":"The serializer's document field is the referenced document subjected to validate_document.","citations":[{"sourceId":"src-d74dd1895d260a60","startLine":2873,"endLine":2881}]},{"id":"control-sharelink-post","kind":"control","statement":"PaperlessObjectPermissions maps POST to the model add permission, so the ShareLink POST authorization concerns adding the ShareLink object.","citations":[{"sourceId":"src-07683b2578aff9f7","startLine":36,"endLine":43}]},{"id":"control-document-owner-aware","kind":"control","statement":"The owner-aware helper allows an owner or a guardian-backed object permission, and otherwise does not allow the document.","citations":[{"sourceId":"src-07683b2578aff9f7","startLine":624,"endLine":635}]},{"id":"condition-document-validation","kind":"condition","statement":"Document validation requires global documents.view_document and a successful owner-aware view_document check on the referenced document.","citations":[{"sourceId":"src-d74dd1895d260a60","startLine":2873,"endLine":2882}]},{"id":"effect-document-denial","kind":"effect","statement":"When the document condition fails, serializer validation raises PermissionDenied, preventing creation of the share-link object.","citations":[{"sourceId":"src-d74dd1895d260a60","startLine":2882,"endLine":2886}]}],"decisiveMissingFacts":[],"suggestedObservations":[]}]}}],"tokens":{"input":169,"output":951,"cacheRead":3456,"cacheWrite":0},"costUsd":null,"durationMs":37015.059499999974,"stopReason":"tool_use"},"schemaValidation":{"valid":true,"diagnostics":[]},"endedAt":"2026-09-29T19:18:38.826Z"}}
