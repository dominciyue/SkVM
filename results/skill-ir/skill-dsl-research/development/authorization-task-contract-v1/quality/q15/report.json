    "results": [
      {
        "obligationId": "scenario%3Aglobal-only-no-document-view::entry%3Ashare-create",
        "conclusion": "source_refuted",
        "explanation": "At the declared ShareLinkViewSet.create entry, the viewset uses IsAuthenticated and PaperlessObjectPermissions, and the POST mapping for that permission class requires add_sharelink for the ShareLink model. Under the premises, the caller's global add_sharelink satisfies authorization to create the share-link object. The create mixin's serializer is obtained through PassUserMixin, which supplies request.user to serializers supporting SerializerWithPerms. During serializer validation, validate_document requires both global documents.view_document and has_perms_owner_aware(..., \"view_document\", document). For a document owned by another user, the owner-aware helper permits only an owner or a guardian-backed object grant; the premises exclude both the owner case and the object grant. Therefore the target-document condition fails and validation raises PermissionDenied before the share-link object is created. The caller's global view_document permission satisfies only the first conjunct; it does not substitute for the owner-aware object check. The observed result is deny for this scenario, distinguishing share-link creation authorization from authorization to view the referenced document.",
        "facts": {
          "entry": [
            {
              "statement": "ShareLinkViewSet is the create-capable viewset entry for ShareLink and uses ShareLinkSerializer.",
              "citations": [
                {
                  "path": "src/documents/views.py",
                  "startLine": 4696,
                  "endLine": 4708,
                  "quote": "class ShareLinkViewSet(\n    PassUserMixin,\n    CreateModelMixin,\n    RetrieveModelMixin,\n    DestroyModelMixin,\n    ListModelMixin,\n    GenericViewSet,\n):\n    model = ShareLink\n\n    queryset = ShareLink.objects.select_related(\"document\")\n\n    serializer_class = ShareLinkSerializer"
                }
              ]
            }
          ],
          "binding": [
            {
              "statement": "ShareLinkViewSet applies IsAuthenticated and PaperlessObjectPermissions.",
              "citations": [
                {
                  "path": "src/documents/views.py",
                  "startLine": 4708,
                  "endLine": 4710,
                  "quote": "    serializer_class = ShareLinkSerializer\n    pagination_class = StandardPagination\n    permission_classes = (IsAuthenticated, PaperlessObjectPermissions)"
                }
              ]
            },
            {
              "statement": "PassUserMixin supplies request.user to serializers that subclass SerializerWithPerms.",
              "citations": [
                {
                  "path": "src/documents/views.py",
                  "startLine": 406,
                  "endLine": 418,
                  "quote": "class PassUserMixin(GenericAPIView[Any]):\n    \"\"\"\n    Pass a user object to serializer\n    \"\"\"\n\n    def get_serializer(self, *args, **kwargs):\n        serializer_class = self.get_serializer_class()\n        if isinstance(serializer_class, type) and issubclass(\n            serializer_class,\n            SerializerWithPerms,\n        ):\n            kwargs.setdefault(\"user\", self.request.user)\n            try:"
                }
              ]
            },
            {
              "statement": "The serializer's document field is the referenced document subjected to validate_document.",
              "citations": [
                {
                  "path": "src/documents/serialisers.py",
                  "startLine": 2873,
                  "endLine": 2881,
                  "quote": "    def validate_document(self, document):\n        if (\n            self.user is not None\n            and self.user.has_perm(\"documents.view_document\")\n            and has_perms_owner_aware(\n                self.user,\n                \"view_document\",\n                document,\n            )"
                }
              ]
            }
          ],
          "control": [
            {
              "statement": "The owner-aware helper allows an owner or a guardian-backed object permission, and otherwise does not allow the document.",
              "citations": [
                {
                  "path": "src/documents/permissions.py",
                  "startLine": 624,
                  "endLine": 635,
                  "quote": "def has_perms_owner_aware(user, perms, obj):\n    \"\"\"\n    Legacy slow path (guardian-backed) single-object permission check.\n\n    The queryset-filtering side of this migrated onto\n    ``PermittedObjectsFilter``/``permitted_object_ids()``, but this\n    single-object check still has many production callers. Several callers\n    remain across ``documents/``, ``paperless_mail/``, and ``paperless_ai/``\n    -- grep for this function name before removing it.\n    \"\"\"\n    checker = ObjectPermissionChecker(user)\n    return obj.owner is None or obj.owner == user or checker.has_perm(perms, obj)"
                }
              ]
            },
            {
              "statement": "PaperlessObjectPermissions maps POST to the model add permission, so the ShareLink POST authorization concerns adding the ShareLink object.",
              "citations": [
                {
                  "path": "src/documents/permissions.py",
                  "startLine": 36,
                  "endLine": 43,
                  "quote": "    perms_map = {\n        \"GET\": [\"%(app_label)s.view_%(model_name)s\"],\n        \"OPTIONS\": [\"%(app_label)s.view_%(model_name)s\"],\n        \"HEAD\": [\"%(app_label)s.view_%(model_name)s\"],\n        \"POST\": [\"%(app_label)s.add_%(model_name)s\"],\n        \"PUT\": [\"%(app_label)s.change_%(model_name)s\"],\n        \"PATCH\": [\"%(app_label)s.change_%(model_name)s\"],\n        \"DELETE\": [\"%(app_label)s.delete_%(model_name)s\"],"
                }
              ]
            }
          ],
          "effect": [
            {
              "statement": "When the document condition fails, serializer validation raises PermissionDenied, preventing creation of the share-link object.",
              "citations": [
                {
                  "path": "src/documents/serialisers.py",
