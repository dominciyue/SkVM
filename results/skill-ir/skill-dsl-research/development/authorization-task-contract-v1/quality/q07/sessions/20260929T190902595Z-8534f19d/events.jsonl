rtLine":1834,"endLine":1839}]},{"id":"f-resource-binding","kind":"binding","statement":"The authorization path resolves request_doc and root_doc, derives the root document, and passes root_doc to the permission check.","citations":[{"sourceId":"src-7632cecb669d34e1","startLine":1401,"endLine":1427}]},{"id":"f-authorization-control","kind":"control","statement":"The visible owner-aware view_document check permits when the checked object is unowned, owned by the caller, or has the requested object permission; otherwise the caller is forbidden.","citations":[{"sourceId":"src-18b8f193a13de576","startLine":624,"endLine":635},{"sourceId":"src-7632cecb669d34e1","startLine":1421,"endLine":1427}]},{"id":"f-condition","kind":"condition","statement":"The stated scenario supplies a different owner for the existing root and no object view grant on that root; therefore, for the root object checked by the source-visible gate, the owner-aware condition is false.","citations":[{"sourceId":"src-18b8f193a13de576","startLine":634,"endLine":635}]},{"id":"f-protected-effect","kind":"effect","statement":"When the root authorization gate passes, the handler selects file_doc and calls serve_file with that object; when the gate fails, it returns HttpResponseForbidden before that effect.","citations":[{"sourceId":"src-7632cecb669d34e1","startLine":1421,"endLine":1448}]},{"id":"f-version-selection","kind":"binding","statement":"A requested version is resolved for the root and the resulting document is returned as the effective file document; this selected version is the object that would be served if authorization proceeded.","citations":[{"sourceId":"src-7632cecb669d34e1","startLine":1375,"endLine":1399},{"sourceId":"src-7632cecb669d34e1","startLine":1437,"endLine":1448}]},{"id":"f-serving","kind":"effect","statement":"serve_file reads the selected doc's archive_file or source_file and constructs the file response.","citations":[{"sourceId":"src-7632cecb669d34e1","startLine":4941,"endLine":49