    {
      "relativePath": "src/documents/serialisers.py",
      "content": "    def create(self, validated_data):\n        validated_data[\"slug\"] = get_random_string(50)\n        return super().create(validated_data)\n\n    def validate_document(self, document):\n        if (\n            self.user is not None\n            and self.user.has_perm(\"documents.view_document\")\n            and has_perms_owner_aware(\n                self.user,\n                \"view_document\",\n                document,\n            )\n        ):\n            return document\n        raise PermissionDenied(\n            _(\"Insufficient permissions.\"),\n        )\n",
      "sha256": "48bf4ad24115a583919803f85cbfa094bda2132e70abaf75ef00574b50a7effa",
