                          "startLine": 1559,
                          "endLine": 1563
                        }
                      ]
                    },
                    {
                      "id": "f-resource",
                      "kind": "binding",
                      "statement": "The destination collection is taken directly from form_data.collection_name when supplied; only an omitted name is replaced with the file-specific default.",
                      "citations": [
                        {
                          "sourceId": "src-eaa1fec9716aeb48",
