facts":[{"id":"entry-create-share","kind":"entry","statement":"CreateMemoShare obtains the current user and rejects a missing user before proceeding.","citations":[{"sourceId":"src-ba5b8420bf39f2db","startLine":23,"endLine":35}]},{"id":"principal-active-admin-binding","kind":"binding","statement":"The author-or-administrator helper requires an active user and accepts either authorship or the administrator role; the administrator predicate also requires normal user status.","citations":[{"sourceId":"src-da9fb2a209342c1f","startLine":55,"endLine":69},{"sourceId":"src-da9fb2a209342c1f","startLine":71,"endLine":85}]},{"id":"memo-resource-binding","kind":"binding","statement":"The handler resolves the memo by the requested memo name, rejects a missing memo, and requires the memo row to be active before authorization.","citations":[{"sourceId":"src-ba5b8420bf39f2db","startLine":37,"endLine":50}]},{"id":"author-or-admin-control","kind":"control","statement":"CreateMemoShare calls access.CanManageMemo and denies the request when that author-or-administrator predicate is false.","citations":[{"sourceId":"src-ba5b8420bf39f2db","startLine":48,"endLine":55}]},{"id":"non-space-condition","kind":"condition","statement":"The handler rejects SPACE-audience memos before share creation; the stated non-SPACE premise therefore satisfies this control.","citations":[{"sourceId":"src-ba5b8420bf39f2db","startLine":51,"endLine":56}]},{"id":"create-share-effect","kind":"effect","statement":"After the authorization and audience checks, the handler creates a share write policy and invokes Store.CreateMemoShare with the selected memo and actor identifiers.","citations":[{"sourceId":"src-ba5b8420bf39f2db","startLine":66,"endLine":77}]},{"id":"store-effect-guard","kind":"control","statement":"The store CreateMemoShare path validates the supplied memo write policy and then delegates the share creation to the driver; this is an operational write path after the handler authorization gate.","citations":[{"sourceId":"src-94b067169ac3605d","startLine":37,"endLine":49}]},{"id":"active-valid-expiry-condition","kind":"condition","statement":"The handler validates a supplied expiry as future-dated before constructing the share effect; the stated valid-expiry premise satisfies this condition.","citations":[{"sourceId":"src-ba5b8420bf39f2db","startLine":57,"endLine":64}]}],"decisiveMissingFacts":[],"suggestedObservations":[]}]}}],"tokens":{"input":14514,"output":1015,"cacheRead":0,"cacheWrite":0},"costUsd":null,"durationMs":21365.1449,"stopReason":"tool_use"},"schemaValidation":{"valid":true,"diagnostics":[]},"endedAt":"2026-09-27T19:14:38.482Z"}}
