    "results": [
      {
        "obligationId": "scenario%3Aversion-owner-no-root-view::entry%3Adownload",
        "conclusion": "source_refuted",
        "explanation": "The download action delegates to file_response. That path binds the authenticated principal from request.user, loads the document named by pk as request_doc, resolves its root as root_doc, and applies the owner-aware view_document check to root_doc—not to the requested version. Under the stated premises, the root is owned by another user and the caller has no object view grant on it, so has_perms_owner_aware returns false and the path returns an insufficient-permissions response before file selection or serving. Ownership of request_doc therefore does not authorize access to root_doc. If authorization passed, the served object would be the effective file document: for a version request_doc with no version query parameter, request_doc itself; otherwise the document selected by version resolution for the root. serve_file then serves that selected document's archive or source file. This source-visible behavior satisfies the accepted requirement that root-document view authorization precede serving any selected version. The assumed global permission and document existence do not alter the decisive root object check.",
        "facts": {
          "entry": [
            {
              "statement": "The detail GET download handler enters at download and delegates the request, pk, and attachment disposition to file_response.",
              "citations": [
                {
                  "path": "src/documents/views.py",
                  "startLine": 1834,
                  "endLine": 1838,
                  "quote": "    @action(methods=[\"get\"], detail=True)\n    def download(self, request, pk=None):\n        try:\n            return self.file_response(pk, request, \"attachment\")\n        except (FileNotFoundError, Document.DoesNotExist):"
                }
              ]
            }
          ],
          "binding": [
            {
              "statement": "The authorization principal is request.user, which is passed to the owner-aware permission check.",
              "citations": [
                {
                  "path": "src/documents/views.py",
                  "startLine": 1421,
                  "endLine": 1424,
                  "quote": "        if request.user is not None and not has_perms_owner_aware(\n            request.user,\n            \"view_document\",\n            root_doc,"
                }
              ]
            },
            {
              "statement": "The document identified by pk is bound as request_doc, and get_root_document resolves the distinct root_doc used by the subsequent authorization logic.",
              "citations": [
                {
                  "path": "src/documents/views.py",
                  "startLine": 1408,
                  "endLine": 1420,
                  "quote": "        manager = Document.global_objects if include_deleted else Document.objects\n        try:\n            request_doc = manager.select_related(\n                \"owner\",\n                \"root_document\",\n            ).get(id=pk)\n        except Document.DoesNotExist:\n            raise Http404\n\n        root_doc = get_root_document(\n            request_doc,\n            include_deleted=include_deleted,\n        )"
                }
              ]
            },
            {
              "statement": "After authorization, file_response chooses the effective file document from request_doc and root_doc; a version request_doc is selected directly when no version parameter is supplied, otherwise version resolution against the root selects the file document.",
              "citations": [
                {
                  "path": "src/documents/views.py",
                  "startLine": 1388,
                  "endLine": 1399,
                  "quote": "    def _get_effective_file_doc(\n        self,\n        request_doc: Document,\n        root_doc: Document,\n        request: Request,\n    ) -> Document:\n        if (\n            request_doc.root_document_id is not None\n            and get_request_version_param(request) is None\n        ):\n            return request_doc\n        return self._resolve_file_doc(root_doc, request)"
                }
              ]
            }
          ],
          "control": [
            {
              "statement": "The decisive control checks view_document on root_doc and returns an insufficient-permissions response when the owner-aware check fails.",
              "citations": [
                {
                  "path": "src/documents/views.py",
                  "startLine": 1421,
                  "endLine": 1427,
                  "quote": "        if request.user is not None and not has_perms_owner_aware(\n            request.user,\n            \"view_document\",\n            root_doc,\n        ):\n            return HttpResponseForbidden(\"Insufficient permissions\")\n        return ResolvedRequestDocs(request_doc=request_doc, root_doc=root_doc)"
                }
              ]
            }
          ],
          "effect": [
            {
              "statement": "Only after the root check succeeds does file_response pass the selected file_doc to serve_file for attachment delivery, choosing archive use from that selected object's archive availability and request options.",
              "citations": [
                {
                  "path": "src/documents/views.py",
                  "startLine": 1429,
                  "endLine": 1448,
                  "quote": "    def file_response(self, pk, request, disposition):\n        resolved = self._resolve_request_and_root_doc(\n            pk,\n            request,\n            include_deleted=True,\n        )\n        if isinstance(resolved, HttpResponseForbidden):\n            return resolved\n        file_doc = self._get_effective_file_doc(\n            resolved.request_doc,\n            resolved.root_doc,\n            request,\n        )\n        return serve_file(\n            doc=file_doc,\n            use_archive=not self.original_requested(request)\n            and file_doc.has_archive_version,\n            disposition=disposition,\n            follow_formatting=request.query_params.get(\"follow_formatting\", False),\n        )"
                }
              ]
            },
            {
              "statement": "serve_file opens either the selected document's archive_file or its source_file and returns it as a FileResponse.",
              "citations": [
                {
                  "path": "src/documents/views.py",
                  "startLine": 4941,
                  "endLine": 4973,
                  "quote": "def serve_file(\n    *,\n    doc: Document,\n    use_archive: bool,\n    disposition: str,\n    follow_formatting: bool = False,\n) -> FileResponse:\n    if use_archive:\n        if TYPE_CHECKING:\n            assert doc.archive_filename\n\n        file_handle = doc.archive_file\n        filename = (\n            doc.archive_filename\n            if follow_formatting\n            else doc.get_public_filename(archive=True)\n        )\n        mime_type = \"application/pdf\"\n    else:\n        if TYPE_CHECKING:\n            assert doc.filename\n\n        file_handle = doc.source_file\n        filename = doc.filename if follow_formatting else doc.get_public_filename()\n        mime_type = doc.mime_type\n        # Support browser previewing csv files by using text mime type\n        if mime_type in {\"application/csv\", \"text/csv\"} and disposition == \"inline\":\n            mime_type = \"text/plain\"\n        # Tell browsers to use UTF-8 for the text files we parse as UTF-8\n        if mime_type in {\"text/plain\", \"text/csv\", \"application/csv\"}:\n            mime_type = f\"{mime_type}; charset=utf-8\"\n\n    response = FileResponse(file_handle, content_type=mime_type)"
                }
              ]
            }
          ],
          "condition": [
            {
              "statement": "The owner-aware check allows when the checked object's owner is absent, the checked object's owner equals the user, or the object permission checker grants the requested permission on that checked object.",
              "citations": [
                {
                  "path": "src/documents/permissions.py",
                  "startLine": 624,
                  "endLine": 635,
                  "quote": "def has_perms_owner_aware(user, perms, obj):\n    \"\"\"\n    Legacy slow path (guardian-backed) single-object permission check.\n\n    The queryset-filtering side of this migrated onto\n    ``PermittedObjectsFilter``/``permitted_object_ids()``, but this\n    single-object check still has many production callers. Several callers\n    remain across ``documents/``, ``paperless_mail/``, and ``paperless_ai/``\n    -- grep for this function name before removing it.\n    \"\"\"\n    checker = ObjectPermissionChecker(user)\n    return obj.owner is None or obj.owner == user or checker.has_perm(perms, obj)"
                }
              ]
            }
          ]
        },
        "decisiveMissingFacts": [],
