      "content": "func ResolveMemoReadContext(ctx context.Context, s MemoReadStore, memo *store.Memo, viewer *store.User, allowAnonymous bool, sharedMemoID *int32) (MemoReadContext, error) {\n\tfacts, err := ResolveMemoReadFacts(ctx, s, memo)\n\tif err != nil {\n\t\treturn MemoReadContext{}, err\n\t}\n\treturn facts.WithViewer(ctx, s, viewer, allowAnonymous, sharedMemoID)\n}\n",
