                      "kind": "binding",
                      "statement": "The authorization principal is request.user, passed to the owner-aware permission check.",
                      "citations": [
                        {
                          "sourceId": "src-7632cecb669d34e1",
                          "startLine": 1421,
                          "endLine": 1424
                        }
                      ]
                    },
