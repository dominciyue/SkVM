    "results": [
      {
        "obligationId": "scenario%3Aglobal-only-no-document-view::entry%3Ashare-create",
        "conclusion": "source_refuted",
        "explanation": "At the declared ShareLinkViewSet.create boundary, the source-visible path denies creation for the stated premises. ShareLinkViewSet uses IsAuthenticated and PaperlessObjectPermissions, and its CreateModelMixin path is bound to ShareLinkSerializer; the viewset declaration also identifies the share-link model. PassUserMixin supplies request.user to SerializerWithPerms serializers. During serializer validation, validate_document first requires global documents.view_document and then requires has_perms_owner_aware(user, \"view_document\", document). The premise supplies the global permission, but the referenced document is owned by another user and has no object-level grant, so the owner-aware check is false: the caller is neither the owner nor a guardian/object-permitted user. Validation raises PermissionDenied before ShareLinkSerializer.create can create the share-link object. Thus global view_document permits neither substitution for nor bypass of the target-document object/owner check. The authorization to create the share-link object is separately represented by PaperlessObjectPermissions' POST mapping to add_<model>; under the stated global add_sharelink premise that share-link creation permission is present, but it does not establish authorization to view the referenced document. This conclusion is limited to the supplied declared-entry source path and does not claim repository-wide completeness.",
        "facts": {
          "entry": [
            {
              "statement": "The assessed entry is ShareLinkViewSet, whose create behavior is supplied by CreateModelMixin.",
              "citations": [
                {
                  "path": "src/documents/views.py",
                  "startLine": 4696,
                  "endLine": 4703,
                  "quote": "class ShareLinkViewSet(\n    PassUserMixin,\n    CreateModelMixin,\n    RetrieveModelMixin,\n    DestroyModelMixin,\n    ListModelMixin,\n    GenericViewSet,\n):"
                }
              ]
            }
          ],
          "binding": [
            {
              "statement": "PassUserMixin passes request.user into serializers that are SerializerWithPerms subclasses.",
              "citations": [
                {
                  "path": "src/documents/views.py",
                  "startLine": 406,
                  "endLine": 418,
                  "quote": "class PassUserMixin(GenericAPIView[Any]):\n    \"\"\"\n    Pass a user object to serializer\n    \"\"\"\n\n    def get_serializer(self, *args, **kwargs):\n        serializer_class = self.get_serializer_class()\n        if isinstance(serializer_class, type) and issubclass(\n            serializer_class,\n            SerializerWithPerms,\n        ):\n            kwargs.setdefault(\"user\", self.request.user)\n            try:"
                }
              ]
            },
            {
              "statement": "The viewset is configured for the ShareLink model and binds ShareLinkSerializer.",
              "citations": [
                {
                  "path": "src/documents/views.py",
                  "startLine": 4704,
                  "endLine": 4708,
                  "quote": "    model = ShareLink\n\n    queryset = ShareLink.objects.select_related(\"document\")\n\n    serializer_class = ShareLinkSerializer"
                }
              ]
            },
            {
              "statement": "The serializer receives the authenticated request user, enabling the document validation checks to run for that caller.",
              "citations": [
                {
                  "path": "src/documents/views.py",
                  "startLine": 411,
                  "endLine": 428,
                  "quote": "    def get_serializer(self, *args, **kwargs):\n        serializer_class = self.get_serializer_class()\n        if isinstance(serializer_class, type) and issubclass(\n            serializer_class,\n            SerializerWithPerms,\n        ):\n            kwargs.setdefault(\"user\", self.request.user)\n            try:\n                full_perms = get_boolean(\n                    str(self.request.query_params.get(\"full_perms\", \"false\")),\n                )\n            except ValueError:\n                full_perms = False\n            kwargs.setdefault(\n                \"full_perms\",\n                full_perms,\n            )\n        return super().get_serializer(*args, **kwargs)"
                }
              ]
            }
          ],
          "control": [
            {
              "statement": "The owner-aware check returns true for an owner or for a user with the object permission; otherwise it relies on the object permission checker, so a non-owner without an object grant fails.",
              "citations": [
                {
                  "path": "src/documents/permissions.py",
                  "startLine": 624,
                  "endLine": 637,
                  "quote": "def has_perms_owner_aware(user, perms, obj):\n    \"\"\"\n    Legacy slow path (guardian-backed) single-object permission check.\n\n    The queryset-filtering side of this migrated onto\n    ``PermittedObjectsFilter``/``permitted_object_ids()``, but this\n    single-object check still has many production callers. Several callers\n    remain across ``documents/``, ``paperless_mail/``, and ``paperless_ai/``\n    -- grep for this function name before removing it.\n    \"\"\"\n    checker = ObjectPermissionChecker(user)\n    return obj.owner is None or obj.owner == user or checker.has_perm(perms, obj)\n\n"
                }
              ]
            },
            {
              "statement": "PaperlessObjectPermissions maps POST to the model add permission, which is the share-link-object creation permission for this viewset.",
              "citations": [
                {
                  "path": "src/documents/permissions.py",
                  "startLine": 30,
                  "endLine": 43,
                  "quote": "class PaperlessObjectPermissions(DjangoObjectPermissions):\n    \"\"\"\n    A permissions backend that checks for object-level permissions\n    or for ownership.\n    \"\"\"\n\n    perms_map = {\n        \"GET\": [\"%(app_label)s.view_%(model_name)s\"],\n        \"OPTIONS\": [\"%(app_label)s.view_%(model_name)s\"],\n        \"HEAD\": [\"%(app_label)s.view_%(model_name)s\"],\n        \"POST\": [\"%(app_label)s.add_%(model_name)s\"],\n        \"PUT\": [\"%(app_label)s.change_%(model_name)s\"],\n        \"PATCH\": [\"%(app_label)s.change_%(model_name)s\"],\n        \"DELETE\": [\"%(app_label)s.delete_%(model_name)s\"],"
                }
              ]
            },
            {
              "statement": "ShareLinkViewSet applies IsAuthenticated and PaperlessObjectPermissions.",
              "citations": [
                {
                  "path": "src/documents/views.py",
                  "startLine": 4708,
                  "endLine": 4714,
                  "quote": "    serializer_class = ShareLinkSerializer\n    pagination_class = StandardPagination\n    permission_classes = (IsAuthenticated, PaperlessObjectPermissions)\n    filter_backends = (\n        DjangoFilterBackend,\n        OrderingFilter,\n        PermittedObjectsFilter,"
                }
              ]
            }
          ],
          "effect": [
            {
              "statement": "When the document validation condition is not satisfied, validation raises PermissionDenied; ShareLinkSerializer.create is therefore not reached for creation.",
              "citations": [
