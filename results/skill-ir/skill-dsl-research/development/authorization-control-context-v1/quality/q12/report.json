                  "path": "src/documents/serialisers.py",
                  "startLine": 2869,
                  "endLine": 2871,
                  "quote": "    def create(self, validated_data):\n        validated_data[\"slug\"] = get_random_string(50)\n        return super().create(validated_data)"
                }
              ]
            }
          ],
          "condition": [
            {
              "statement": "Document validation requires both global documents.view_document and the owner-aware has_perms_owner_aware view_document check on the referenced document.",
              "citations": [
                {
                  "path": "src/documents/serialisers.py",
                  "startLine": 2873,
                  "endLine": 2881,
                  "quote": "    def validate_document(self, document):\n        if (\n            self.user is not None\n            and self.user.has_perm(\"documents.view_document\")\n            and has_perms_owner_aware(\n                self.user,\n                \"view_document\",\n                document,\n            )"
