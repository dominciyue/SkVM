alse","unknown"]}},"required":["conditionId","value"],"additionalProperties":false}},"effect":{"type":"string","enum":["reachable","blocked","unknown"]},"explanation":{"type":"string"},"missingFacts":{"type":"array","items":{"type":"string"}},"factIds":{"type":"array","items":{"type":"string"}}},"required":["id","assumptions","effect","explanation","missingFacts","factIds"],"additionalProperties":false}}},"required":["obligationId","explanation","facts","decisiveMissingFacts","suggestedObservations","decision","branchResults"],"additionalProperties":false}}},"required":["results"],"additionalProperties":false}]},"usage":{"input":8812,"output":1117,"cacheRead":1408,"cacheWrite":0},"costUsd":null,"transportAttempts":"unknown","response":{"text":"","toolCalls":[{"id":"call_ODjWFUJuPFDCLYBwlYjoCRPw","name":"submit_authorization_result","arguments":{"results":[{"obligationId":"scenario%3Aglobal-only-no-document-view::entry%3Ashare-create","decision":{"kind":"observed","observed":"deny"},"branchResults":[],"explanation":"Observed behavior is deny. At the declared ShareLinkViewSet entry, the viewset applies IsAuthenticated and PaperlessObjectPermissions. The latter uses DjangoObjectPermissions' POST mapping to require the global add permission for the ShareLink model, which addresses authorization to create the share-link object. The create path then validates the submitted document through ShareLinkSerializer.validate_document. That validator requires both the global documents.view_document permission and has_perms_owner_aware(..., \"view_document\", document). For an authenticated caller who has the global view permission but does not own the other user's document and has no object-level view grant, the owner-aware check is false: the helper allows only an unowned object, the owner, or a successful object-permission check. The validator therefore raises PermissionDenied before ShareLinkSerializer.create can create the object. Global view_document satisfies only the global prerequisite; it does not substitute for the owner-aware target-document check. Thus the caller cannot create the share link under the stated premises.","facts":[{"id":"entry-share-create","kind":"entry","statement":"The analyzed entry is ShareLinkViewSet, whose create-capable viewset includes CreateModelMixin and declares its serializer and permission classes.","citations":[{"sourceId":"src-64b8926d5eb16fbb","startLine":4696,"endLine":4710}]},{"id":"binding-sharelink-permissions","kind":"binding","statement":"ShareLinkViewSet applies IsAuthenticated and PaperlessObjectPermissions to the request.","citations":[{"sourceId":"src-64b8926d5eb16fbb","startLine":4704,"endLine":4710}]},{"id":"control-sharelink-create-global","kind":"control","statement":"PaperlessObjectPermissions maps POST to the model add permission, so for this ShareLink viewset creation is governed by the global add_sharelink permission in addition to authentication.","citations":[{"sourceId":"src-81f6400744c9c9e9","startLine":30,"endLine":43}]},{"id":"binding-document-validation","kind":"binding","statement":"ShareLinkSerializer validates the submitted document in validate_document and only returns it when the global view permission and owner-aware view check both succeed.","citations":[{"sourceId":"src-baa9e644e5441f97","startLine":2873,"endLine":2883}]},{"id":"control-owner-aware-document","kind":"control","statement":"The owner-aware helper permits an object only when it is unowned, owned by the caller, or passes the guardian object-permission check; a document owned by another user with no object view grant fails this condition.","citations":[{"sourceId":"src-81f6400744c9c9e9","startLine":624,"endLine":635}]},{"id":"condition-global-view-not-substitute","kind":"condition","statement":"The serializer's global documents.view_document test is conjunctive with, rather than a substitute for, the owner-aware document check.","citations":[{"sourceId":"src-baa9e644e5441f97","startLine":2873,"endLine":2882}]},{"id":"effect-sharelink-denied","kind":"effect","statement":"When the target-document validation condition fails, ShareLinkSerializer raises PermissionDenied, preventing creation of the share-link object on this path.","citations":[{"sourceId":"src-baa9e644e5441f97","startLine":2883,"endLine":2886}]}],"decisiveMissingFacts":[],"suggestedObservations":[]}]}}],"tokens":{"input":8812,"output":1117,"cacheRead":1408,"cacheWrite":0},"costUsd":null,"durationMs":67976.55520000006,"stopReason":"tool_use"},"schemaValidation":{"valid":true,"diagnostics":[]},"endedAt":"2026-09-28T18:25:03.675Z"}}
