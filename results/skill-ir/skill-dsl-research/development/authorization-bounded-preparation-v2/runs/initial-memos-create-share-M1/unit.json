      "results": [
        {
          "obligationId": "scenario%3Aadmin-other-memo::entry%3Acreate-share",
          "conclusion": "source_refuted",
          "explanation": "At the declared handler-entry boundary, the source-visible controls allow the stated administrator scenario to reach the share-creation effect. CreateMemoShare obtains the current user and rejects a nil user, retrieves the memo, requires an active memo, and calls access.CanManageMemo before creating the share. CanManageMemo requires a non-nil memo and delegates to ownsOrAdministers; that helper requires an active actor and accepts either matching creator ID or the administrator role. Under the stated premise of an authenticated active instance ADMIN acting on another user's memo, the administrator branch passes. The handler separately rejects SPACE-audience memos, and the stated memo is non-SPACE. The protected effect is the subsequent Store.CreateMemoShare call with the selected memo and caller in the write policy. This is an authorization conclusion at declared entry only; it does not assert store-call success or decide downstream behavior or concurrent state changes.",
          "facts": {
            "entry": [
              {
                "statement": "CreateMemoShare obtains the current user and rejects a nil user as unauthenticated before proceeding.",
                "citations": [
                  {
                    "path": "server/api/v1/memo_share_service.go",
                    "startLine": 25,
                    "endLine": 32,
                    "quote": "func (s *APIV1Service) CreateMemoShare(ctx context.Context, request *v1pb.CreateMemoShareRequest) (*v1pb.MemoShare, error) {\n\tuser, err := s.fetchCurrentUser(ctx)\n\tif err != nil {\n\t\treturn nil, status.Errorf(codes.Internal, \"failed to get user\")\n\t}\n\tif user == nil {\n\t\treturn nil, status.Errorf(codes.Unauthenticated, \"user not authenticated\")\n\t}"
                  }
                ]
              }
            ],
            "binding": [
              {
                "statement": "ownsOrAdministers requires an active user and permits either matching creator ID or the administrator role.",
                "citations": [
                  {
                    "path": "core/access/memo.go",
                    "startLine": 83,
                    "endLine": 85,
                    "quote": "func ownsOrAdministers(actor *store.User, creatorID int32) bool {\n\treturn IsActiveUser(actor) && (actor.ID == creatorID || actor.Role == store.RoleAdmin)\n}"
                  }
                ]
              },
              {
                "statement": "CanManageMemo requires a non-nil memo and delegates authorization to ownsOrAdministers.",
                "citations": [
                  {
                    "path": "core/access/memo.go",
                    "startLine": 73,
                    "endLine": 74,
                    "quote": "func CanManageMemo(actor *store.User, memo *store.Memo) bool {\n\treturn memo != nil && ownsOrAdministers(actor, memo.CreatorID)"
                  }
                ]
              },
              {
                "statement": "The handler extracts the memo UID, retrieves the memo, and treats an absent memo as not found.",
                "citations": [
                  {
                    "path": "server/api/v1/memo_share_service.go",
                    "startLine": 37,
                    "endLine": 47,
                    "quote": "\tmemoUID, err := ExtractMemoUIDFromName(request.Parent)\n\tif err != nil {\n\t\treturn nil, status.Errorf(codes.InvalidArgument, \"invalid memo name: %v\", err)\n\t}\n\tmemo, err := s.Store.GetMemo(ctx, &store.FindMemo{UID: &memoUID})\n\tif err != nil {\n\t\treturn nil, status.Errorf(codes.Internal, \"failed to get memo\")\n\t}\n\tif memo == nil {\n\t\treturn nil, status.Errorf(codes.NotFound, \"memo not found\")\n\t}"
                  }
                ]
              }
            ],
            "control": [
              {
                "statement": "The handler requires an active memo and then applies access.CanManageMemo; failure produces PermissionDenied.",
                "citations": [
                  {
                    "path": "server/api/v1/memo_share_service.go",
                    "startLine": 48,
                    "endLine": 53,
                    "quote": "\tif memo.RowStatus != store.Normal {\n\t\treturn nil, status.Errorf(codes.FailedPrecondition, \"only active memos can be shared\")\n\t}\n\tif !access.CanManageMemo(user, memo) {\n\t\treturn nil, status.Errorf(codes.PermissionDenied, \"permission denied\")\n\t}"
                  }
                ]
              },
              {
                "statement": "An error returned by Store.CreateMemoShare is handled after the effect is invoked and does not alter the preceding authorization control result.",
                "citations": [
                  {
                    "path": "server/api/v1/memo_share_service.go",
                    "startLine": 76,
                    "endLine": 77,
                    "quote": "\tif err != nil {\n\t\treturn nil, mapMemoWriteError(err, \"failed to create memo share\")"
                  }
                ]
              }
            ],
            "effect": [
              {
                "statement": "After the authorization and audience checks, the handler constructs a share write policy and invokes Store.CreateMemoShare for the selected memo and caller.",
                "citations": [
                  {
                    "path": "server/api/v1/memo_share_service.go",
                    "startLine": 66,
                    "endLine": 75,
                    "quote": "\t// Generate a URL-safe token using shortuuid (base57-encoded UUID v4, 22 chars, 122-bit entropy).\n\tpolicy := memoWritePolicy(user.ID, false)\n\tpolicy.CreatingShare = true\n\tms, err := s.Store.CreateMemoShare(ctx, &store.MemoShare{\n\t\tUID:       shortuuid.New(),\n\t\tMemoID:    memo.ID,\n\t\tCreatorID: user.ID,\n\t\tExpiresTs: expiresTs,\n\t\tPolicy:    policy,\n\t})"
                  }
                ]
              }
            ],
            "condition": [
              {
                "statement": "The handler rejects memos whose audience is SPACE before attempting share creation.",
                "citations": [
                  {
                    "path": "server/api/v1/memo_share_service.go",
                    "startLine": 54,
                    "endLine": 56,
                    "quote": "\tif memo.Visibility == store.SpaceAudience {\n\t\treturn nil, status.Errorf(codes.FailedPrecondition, \"SPACE audience memos cannot be shared\")\n\t}"
                  }
                ]
              }
            ]
          },
