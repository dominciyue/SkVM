{
  "openapi": "3.1.0",
  "info": {
    "title": "Synthetic accepted inline path",
    "version": "1.0.0"
  },
  "paths": {
    "/items/{itemId}": {
      "get": {
        "summary": "Read one item",
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Item found"
          },
          "404": {
            "description": "Item not found"
          }
        }
      }
    }
  }
}
